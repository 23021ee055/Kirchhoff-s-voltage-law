print("=" * 40)
print("       ELECTRICAL LOAD ANALYZER")
print("=" * 40)

n = int(input("Enter number of appliances: "))

total_power = 0
total_energy = 0

for i in range(n):
    print("\nAppliance", i + 1)

    name = input("Enter appliance name: ")
    power = float(input("Enter power rating (W): "))
    quantity = int(input("Enter quantity: "))
    hours = float(input("Enter usage hours/day: "))

    appliance_power = power * quantity
    daily_energy = appliance_power * hours / 1000
    monthly_energy = daily_energy * 30

    total_power += appliance_power
    total_energy += monthly_energy

    print("Appliance:", name)
    print("Connected Load:", appliance_power, "W")
    print("Monthly Energy:",
          round(monthly_energy, 2), "kWh")

print("\n" + "=" * 40)
print("TOTAL CONNECTED LOAD:",
      total_power, "W")
print("TOTAL MONTHLY ENERGY:",
      round(total_energy, 2), "kWh")
print("=" * 40)

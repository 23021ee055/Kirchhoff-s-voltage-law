import java.util.Scanner;

public class KVL {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        System.out.println("KIRCHHOFF'S VOLTAGE LAW");

        System.out.print("Enter supply voltage (V): ");
        double Vs = sc.nextDouble();

        System.out.print("Enter voltage V1 (V): ");
        double V1 = sc.nextDouble();

        System.out.print("Enter voltage V2 (V): ");
        double V2 = sc.nextDouble();

        double V3 = Vs - V1 - V2;

        System.out.println("Voltage V3 = " + V3 + " V");
        System.out.println("Sum of voltage drops = "
                + (V1 + V2 + V3) + " V");

        sc.close();
    }
}# Kirchhoff-s-voltage-law
